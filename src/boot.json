{
  "name": "ModHub",
  "version": "1.8.3",
  "nickName": {
    "zh-CN": "模组管理器与市场套件",
    "zh-TW": "模組管理器與市場套件",
    "en": "Mod Manager and Market Suite"
  },
  "description": "DoL 原生暗黑风格模组管理与市场套件",
  "styleFileList": [
    "stylesheet/modhub.css",
    "stylesheet/modhub-market.css",
    "stylesheet/modhub-overrides.css"
  ],
  "scriptFileList_inject_early": [
    "javascript/modhub-style.js",
    "javascript/modhub-i18n.js",
    "javascript/modhub-i18n-manager.js",
    "javascript/modhub-i18n-market.js",
    "javascript/modhub-i18n-help.js",
    "javascript/modhub-i18n-tools.js",
    "javascript/modhub-dialog.js",
    "javascript/modhub-restore-panel.js",
    "javascript/modhub-restore.js"
  ],
  "scriptFileList": [
    "javascript/modhub-manager.js",
    "javascript/modhub-drag.js",
    "javascript/modhub-beauty.js",
    "javascript/modhub-readme.js",
    "javascript/modhub-log.js",
    "javascript/modhub-market-variants.js",
    "javascript/modhub-wiki-title.js",
    "javascript/modhub-search.js",
    "javascript/modhub-market.js",
    "javascript/modhub-market-spells.js",
    "javascript/modhub-market-versions.js",
    "javascript/modhub-market-install.js",
    "javascript/modhub-ai-package.js",
    "vendor/json5/index.min.js",
    "javascript/modhub-compat.js",
    "javascript/modhub-compat-panel.js",
    "javascript/modhub-ai-repair.js",
    "javascript/modhub-remote-protocol.js",
    "javascript/modhub-game-command.js",
    "javascript/modhub-remote-assist.js",
    "javascript/modhub-help.js"
  ],
  "tweeFileList": [
    "twee/modloader/modloader.twee"
  ],
  "imgFileList": [],
  "addonPlugin": [
    {
      "modName": "TweeReplacer",
      "addonName": "TweeReplacerAddon",
      "modVersion": "^1.0.0",
      "params": [
        {
          "tip": "【ModHub】管理界面主入口",
          "passage": "overlayReplace",
          "findString": "<<case \"characteristics\">>",
          "replaceFile": "twee/modloader/modloader-patch-base.twee"
        },
        {
          "tip": "【ModHub】顶栏 ModHub 按钮",
          "passage": "Widgets Clothing Caption",
          "findString": "\t\t\t<<overlayReplace \"startFeats\">>\n\t\t<</button>>\n\t</div>",
          "replaceFile": "twee/modloader/modloader-patch-caption.twee"
        },
        {
          "tip": "【ModHub】侧栏 ModHub 按钮",
          "passage": "StoryCaption",
          "findRegex": "<<overlayReplace \\\"saves\\\">>\\r?\\n\\s*<</button>>\\r?\\n\\s*</div>",
          "regexFlag": "g",
          "replaceFile": "twee/modloader/modloader-patch-story-caption.twee"
        }
      ]
    }
  ],
  "dependenceInfo": [
    {
      "modName": "TweeReplacer",
      "version": "^1.0.0"
    }
  ]
}
