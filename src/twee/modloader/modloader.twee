:: modhub-manager [widget]
<<widget "titleModloader">>
	<<setupTabs _args[0]>>
	<div id="overlayTabs" class="tab modhub-modloader-tabs">
		<<closeButtonMobile>>
		<<button "模组管理">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<modloadermodmanage>><</replace>>
		<</button>>
		<<button "模组市场">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<modloadermarket>><</replace>>
		<</button>>
		<<button "模组说明">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<modloaderreadme>><</replace>>
		<</button>>
		<<button "加载日志">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<modloaderlog>><</replace>>
		<</button>>
		<<button "帮助中心">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<modloaderhelp>><</replace>>
		<</button>>
		<<run setTimeout(window.modHubInitOverlayTabs, 0)>>
	</div>
	<<closeButton>>
<</widget>>

<<widget "modloadergeneral">>
	<<modloadermodmanage>>
<</widget>>

<<widget "modhubloading">>
	<<print window.modHubLoadingHtml(_args[0])>>
<</widget>>

<<widget "modloadermodmanage">>
	<div id="modHubModManageContainer" class="modhub-container"><<modhubloading "正在读取模组列表…">></div>
	<<run setTimeout(initModManage, 1)>>
<</widget>>

<<widget "modloaderreadme">>
	<div id="modHubReadmeContainer" class="modhub-container"><<modhubloading "正在读取模组说明…">></div>
	<<run setTimeout(initModReadMe, 1)>>
<</widget>>

<<widget "modloaderlog">>
	<div id="modHubLogContainer" class="modhub-container">
		<div class="modhub-group-header">
			<span class="gold">模组加载过程日志</span>
			<div class="modhub-log-header-actions">
				<button id="btnToggleLogFullscreen" type="button" class="macro-button modhub-btn-secondary" onclick="window.modHubToggleLogFullscreen()">全屏展示</button>
				<button type="button" class="macro-button modhub-btn-secondary" onclick="window.modHubCaptureLogScreenshot()">一键截图</button>
				<button type="button" class="macro-button modhub-btn-primary" onclick="window.modHubCopyLoadLog()">复制日志</button>
			</div>
		</div>
		<div id="modHubLogDiagnosisContainer"><<modhubloading "正在读取加载日志…">></div>
		<div class="modhub-log-toolbar">
			<div class="modhub-log-search-row">
				<input id="modHubLogSearch" class="modhub-search-input modhub-log-search" type="search" placeholder="搜索日志内容……" aria-label="搜索日志内容">
				<span id="modHubLogSearchStatus" class="modhub-log-search-status grey">0/0</span>
			</div>
			<div class="modhub-log-actions-row" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px;">
				<div class="modhub-log-filter-group">
					<button type="button" class="modhub-log-filter-btn active" data-filter="all" onclick="window.modHubSetLogLevelFilter('all')">全部</button>
					<button id="modHubFilterError" type="button" class="modhub-log-filter-btn filter-error" data-filter="error" onclick="window.modHubSetLogLevelFilter('error')">仅错误</button>
					<button id="modHubFilterWarn" type="button" class="modhub-log-filter-btn filter-warn" data-filter="warn" onclick="window.modHubSetLogLevelFilter('warn')">仅警告</button>
					<button type="button" class="modhub-log-filter-btn" data-filter="issues" onclick="window.modHubSetLogLevelFilter('issues')">错误+警告</button>
				</div>
				<div style="display: flex; gap: 4px; align-items: center;">
					<button type="button" class="macro-button modhub-log-btn" onclick="window.modHubMoveLogMatch(-1)">↑ 上一处</button>
					<button type="button" class="macro-button modhub-log-btn" onclick="window.modHubMoveLogMatch(1)">↓ 下一处</button>
					<button id="modHubLogErrors" type="button" class="macro-button modhub-log-btn" onclick="window.modHubJumpToLevel('error')"><span class="red">错误</span></button>
					<button id="modHubLogWarnings" type="button" class="macro-button modhub-log-btn" onclick="window.modHubJumpToLevel('warn')"><span class="gold">警告</span></button>
				</div>
			</div>
		</div>
		<div id="modHubLogContent" class="modhub-log-wrapper"></div>
	</div>
	<<script>>
		setTimeout(() => {
			if (typeof window.modHubInitLogTools === 'function') {
				window.modHubInitLogTools();
			}
		}, 1);
	<</script>>
<</widget>>

<<widget "modloadermarket">>
	<div id="modHubModMarketContainer" class="modhub-container"><<modhubloading "正在读取模组市场…">></div>
	<<run setTimeout(window.modHubInitMarket, 1)>>
<</widget>>

<<widget "modloaderhelp">>
	<div id="modHubHelpContainer" class="modhub-container modhub-help"><<modhubloading "正在读取帮助中心…">></div>
	<<run setTimeout(() => window.modHubHelp?.init(), 1)>>
<</widget>>
